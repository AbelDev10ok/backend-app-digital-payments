# Variables de entorno del backend (Spring Boot 3.5 + PostgreSQL)
#
# Este archivo es DOCUMENTACION, no configuracion: Spring Boot no lee .env.
# Copialo como referencia y defini cada variable en el entorno real:
#   - Desarrollo Windows:      setx DB_PASSWORD "tu-password"   (abrir una terminal nueva)
#   - Desarrollo Linux/macOS:  export DB_PASSWORD="tu-password"
#   - IDE (VS Code / IntelliJ): configuracion de arranque de la app
#   - Produccion:              variables del proveedor (Railway, Render, Fly.io, etc.)
#
# El perfil `prod` (SPRING_PROFILES_ACTIVE=prod) activa application-prod.properties
# y hace fail-fast: si falta JWT_SECRET o DB_PASSWORD, la app no arranca.
# StartupSecurityCheck valida esos dos al arrancar.

# ---------------------------------------------------------------------------
# Base de datos (obligatorias)
# ---------------------------------------------------------------------------
# En desarrollo el default del URL es jdbc:postgresql://localhost:5432/digital_payments
# En produccion no hay default: DB_URL es obligatoria.
DB_URL=jdbc:postgresql://localhost:5432/digital_payments
DB_USERNAME=postgres
# Sin default en el repo. Obligatoria en desarrollo y en produccion.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Seguridad (obligatoria en produccion)
# ---------------------------------------------------------------------------
# Clave HS512 de firma de JWT. Minimo 64 caracteres.
# Sin JWT_SECRET la app genera una clave aleatoria por arranque y TODOS los
# tokens mueren en cada reinicio (re-login forzado en desarrollo).
# Generar una:  openssl rand -base64 64
JWT_SECRET=

# ---------------------------------------------------------------------------
# URLs publicas y CORS (obligatorias en produccion)
# ---------------------------------------------------------------------------
# Origenes permitidos por CORS, separados por comas. En desarrollo el default
# es http://localhost:5173. En produccion debe incluir el dominio real del SPA.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL publica del frontend. Se usa en el mail de restablecimiento de password
# (link a /reset-password) y como back_url del checkout de Mercado Pago.
APP_FRONTEND_URL=http://localhost:5173

# URL publica del webhook de Mercado Pago. Vacia en desarrollo: WebhookRegistrar
# avisa en el log y no registra nada en MP. En produccion debe ser el dominio
# fijo del backend + /api/webhooks/mercadopago.
APP_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Mercado Pago (suscripciones del SaaS)
# ---------------------------------------------------------------------------
# Sin credenciales en el repo. Vacias en desarrollo: la app arranca y las
# suscripciones quedan deshabilitadas (isConfigured() == false).
# En produccion son obligatorias: application-prod.properties no tiene default.
# El prefijo APP_USR- NO distingue test de produccion: verifica la cuenta con
# GET https://api.mercadopago.com/users/me (tags: test_user = cuenta de prueba).
APP_MERCADOPAGO_ACCESS_TOKEN=
APP_MERCADOPAGO_WEBHOOK_SECRET=

# Firma obligatoria del webhook cuando hay secreto configurado.
# Desactivar (false) solo en desarrollo.
APP_WEBHOOK_REQUIRE_SIGNATURE=true

# ---------------------------------------------------------------------------
# Rate limiting (opcionales, tienen default)
# ---------------------------------------------------------------------------
# Solicitudes por minuto por IP + ruta.
APP_RATE_LIMIT_PER_MINUTE=10
# Limite mas estricto para login/register/refresh/forgot/reset.
APP_RATE_LIMIT_SENSITIVE_PER_MINUTE=5
# Confiar en X-Forwarded-For / X-Real-IP solo si hay un proxy reverso de confianza.
APP_RATE_LIMIT_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# SMTP (mails de verificacion y restablecimiento)
# ---------------------------------------------------------------------------
# Viven en src/main/resources/email.properties (gitignoreado). Si no se
# definen, el default del archivo local se usa.
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Perfil de Spring
# ---------------------------------------------------------------------------
# `prod` activa application-prod.properties (fail-fast de secretos, sin show-sql).
# Vacio = perfil de desarrollo.
SPRING_PROFILES_ACTIVE=
