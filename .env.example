# Variables de entorno del backend (Spring Boot 3.5 + PostgreSQL)
#
# Este archivo es DOCUMENTACION, no configuracion: Spring Boot no lee .env.
# Copialo como referencia y defini cada variable en el entorno:
#   - Desarrollo Windows:      setx DB_PASSWORD "tu-password"   (y reiniciar la terminal)
#   - Desarrollo Linux/macOS:  export DB_PASSWORD="tu-password"
#   - IDE:                     configuracion de arranque de la app
#   - Produccion:              variables del proveedor (Railway, Render, Fly.io)
#
# El perfil `prod` (SPRING_PROFILES_ACTIVE=prod) activa application-prod.properties
# y hace fail-fast: sin JWT_SECRET ni DB_PASSWORD la app no arranca.
# StartupSecurityCheck valida ambas al arrancar.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# En desarrollo, la URL y el usuario tienen default en application.properties.
# En produccion no hay default: DB_URL es obligatoria.
DB_URL=jdbc:postgresql://localhost:5432/digital_payments
DB_USERNAME=postgres
# Sin default en el repo. Obligatoria en desarrollo y en produccion.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Clave HS512 de firma de JWT. Obligatoria en produccion.
# Sin JWT_SECRET se genera una clave aleatoria por boot y TODOS los tokens
# mueren en cada reinicio (te obliga a loguearte de nuevo en desarrollo).
# Generar: openssl rand -base64 64
JWT_SECRET=

# ---------------------------------------------------------------------------
# URLs publicas y CORS
# ---------------------------------------------------------------------------
# Origenes permitidos por CORS, separados por comas. El default de desarrollo
# es http://localhost:5173. En produccion, el dominio del SPA.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL publica del frontend. Se usa en los mails de verificacion y de
# restablecimiento de contrasena, y como back_url del checkout de MP.
APP_FRONTEND_URL=http://localhost:5173

# URL publica del webhook de MP. Vacia en desarrollo: WebhookRegistrar avisa
# en el log y no registra nada. En produccion: dominio fijo + /api/webhooks/mercadopago.
APP_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Mercado Pago (suscripciones del SaaS)
# ---------------------------------------------------------------------------
# Sin credenciales en el repo. Vacias en desarrollo: la app arranca y las
# suscripciones quedan deshabilitadas (isConfigured() devuelve false).
# En produccion son obligatorias (application-prod.properties no tiene default).
# El prefijo APP_USR- NO distingue test de produccion: verifica la cuenta con
# GET /users/me (tags: test_user = cuenta de prueba).
APP_MERCADOPAGO_ACCESS_TOKEN=
APP_MERCADOPAGO_WEBHOOK_SECRET=

# Firma obligatoria del webhook cuando hay secreto configurado.
# Desactivar solo en desarrollo.
APP_WEBHOOK_REQUIRE_SIGNATURE=true

# ---------------------------------------------------------------------------
# Rate limiting (opcionales)
# ---------------------------------------------------------------------------
# Solicitudes por minuto por IP + ruta.
APP_RATE_LIMIT_PER_MINUTE=10
# Limite mas estricto para login/register/refresh/forgot/reset.
APP_RATE_LIMIT_SENSITIVE_PER_MINUTE=5
# Confiar en X-Forwarded-For / X-Real-IP solo con proxy reverso de confianza.
APP_RATE_LIMIT_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# SMTP (mails de verificacion y restablecimiento)
# ---------------------------------------------------------------------------
# Viven en src/main/resources/email.properties (gitignoreado).
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Perfil de Spring
# ---------------------------------------------------------------------------
# `prod` activa application-prod.properties (fail-fast de secretos, sin show-sql).
# Vacio = desarrollo.
SPRING_PROFILES_ACTIVE=
